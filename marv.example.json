{
  "Server": "irc.libera.chat",
  "Port": 6697,
  "UseTls": true,
  "TlsSkipCertificateValidation": false,
  "TlsCaCertFile": null,
  "Nick": "Marv",
  "User": "marv",
  "RealName": "Marv IRC Bot",
  "SaslUser": null,
  "SaslPassword": null,
  "NickServPassword": null,
  "Channels": ["#marv-test"],
  "CommandPrefix": "!",
  "PluginDirectories": ["plugins"],
  "Plugins": [
    "Greet",
    "Auth",
    "AuthConsumer",
    "CannedResponses"
  ],
  "Plugins:Greet": {
    "GreetMessage": "Welcome, {nick}!",
    "GreetOnJoin": true
  },
  "Plugins:Auth": {
    "AdminAccounts": ["myadmin"]
  }
}
